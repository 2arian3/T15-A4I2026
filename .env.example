# Copy to .env (or run `make env`). .env is gitignored.
# Gemini through Vertex AI (Gemini platform), not an AI Studio API key.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-e3eaf2b4f0c3
# Gemini 3.x is served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global
CURBSIDE_MODEL=gemini-3.6-flash

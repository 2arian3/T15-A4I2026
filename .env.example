# Copy to .env (or run `make env`). .env is gitignored.
# Gemini through Vertex AI (Gemini platform), not an AI Studio API key.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-e3eaf2b4f0c3
# App project ID; Agent Runtime controls GOOGLE_CLOUD_PROJECT itself.
CURBSIDE_PROJECT_ID=qwiklabs-gcp-04-e3eaf2b4f0c3
# Gemini 3.x is served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global
CURBSIDE_MODEL=gemini-3.8-flash
# Private MCP Toolbox Cloud Run origin; no /mcp suffix.
TOOLBOX_URL=
BQ_DATASET=a4i_health
BQ_AUDIT_DATASET=a4i_audit
CURBSIDE_RUNTIME_SA=curbside-agent@qwiklabs-gcp-04-e3eaf2b4f0c3.iam.gserviceaccount.com
SECOND_LANGUAGE=Spanish
# Needed only by make load-audit. Request and activate your own Census API key:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Optional development call/token logs:
# CURBSIDE_DEV_LOGGING=1
# Optional pre-provisioned analytics dataset (runtime needs write permissions there):
# CURBSIDE_ANALYTICS_DATASET=curbside_analytics
